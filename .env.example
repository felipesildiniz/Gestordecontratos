# Copie este arquivo para ".env" (mesma pasta) e preencha os valores.
# NUNCA compartilhe o arquivo .env: ele guarda as senhas do sistema.

# Chave secreta do sistema. Gere uma com este comando:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Deixe False em uso normal.
DJANGO_DEBUG=False

# Nomes ou IPs pelos quais o servidor será acessado, separados por vírgula.
# Exemplo: localhost,127.0.0.1,192.168.0.10,servidor-contratos
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Banco de dados PostgreSQL
DB_NOME=gestor_contratos
DB_USUARIO=gestor
DB_SENHA=
DB_HOST=localhost
DB_PORTA=5432

# Servidor
SERVIDOR_HOST=0.0.0.0
SERVIDOR_PORTA=8000

# Backup (etapa E4.1)
# Onde ficam os PDFs enviados ao sistema (deixe em branco para usar a pasta "media").
ARQUIVOS_PASTA=
# Onde ficam os backups (em branco = pasta "backups" dentro do sistema).
BACKUP_PASTA=
# SEGUNDO LOCAL dos backups: disco externo ou pasta de outro computador.
# Muito recomendado: se o disco do servidor falhar, os backups locais se perdem junto.
# Exemplo: BACKUP_PASTA_COPIA=E:\backups-gestor
BACKUP_PASTA_COPIA=
# Quantos backups manter em cada local (os mais antigos são apagados).
BACKUP_MANTER=30
# Só se o PostgreSQL não for encontrado sozinho: pasta "bin" dele.
# Exemplo: PG_BIN=C:\Program Files\PostgreSQL\17\bin
PG_BIN=

# Internet (E4.2). Em hospedagem na nuvem com HTTPS, use True.
DJANGO_USAR_HTTPS=False
# Tempo do cabeçalho HSTS, em segundos (padrão 3600; depois de confirmar tudo, 31536000).
DJANGO_HSTS_SEGUNDOS=
# Domínios do sistema (ex.: .up.railway.app) e origens confiáveis (ex.: https://*.up.railway.app).
# Veja DJANGO_ALLOWED_HOSTS acima e DJANGO_CSRF_TRUSTED_ORIGINS.
